<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="The Falcon Mechatronics 5.0 V8 — Projetos CAD 3D, engenharia mecatrônica, prototipagem e usinagem CNC de alta precisão.">

    <title>The Falcon Mechatronics 5.0 V8 | Engenharia & CNC</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Orbitron:wght@600;800;900&display=swap"
        rel="stylesheet"
    >

    <style>
        :root {
            --bg-deep-blue: #060d1b;
            --bg-card-blue: #0f1c3f;
            --bg-card-hover: #162858;

            --blue-primary: #0066ff;
            --blue-electric: #00d2ff;

            --blue-glow: rgba(0, 210, 255, 0.3);

            --text-main: #f0f6fc;
            --text-muted: #94a3b8;

            --border-blue: #1e3a70;

            --gradient-hero:
                linear-gradient(
                    135deg,
                    #060d1b 0%,
                    #0a1b3a 50%,
                    #002255 100%
                );

            --gradient-btn:
                linear-gradient(
                    135deg,
                    #0052cc,
                    #00d2ff
                );
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: var(--bg-deep-blue);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            line-height: 1.6;
            overflow-x: hidden;
        }

        img {
            max-width: 100%;
        }

        a {
            color: inherit;
        }

        .container {
            width: 100%;
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* =========================
           HEADER
        ========================= */

        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;

            background: rgba(6, 13, 27, 0.94);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);

            border-bottom: 1px solid var(--border-blue);

            z-index: 1000;
        }

        nav {
            min-height: 80px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;
        }

        .logo {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.15rem;
            font-weight: 900;

            color: #fff;

            letter-spacing: 0.5px;

            display: flex;
            align-items: center;
            gap: 8px;

            white-space: nowrap;
        }

        .logo span {
            color: var(--blue-electric);
            text-shadow: 0 0 12px var(--blue-glow);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 24px;

            list-style: none;
        }

        .nav-links a {
            color: var(--text-muted);
            text-decoration: none;

            font-size: 0.9rem;
            font-weight: 500;

            transition: 0.3s ease;
        }

        .nav-links a:hover {
            color: var(--blue-electric);
        }

        /* =========================
           BOTÕES
        ========================= */

        .btn {
            display: inline-block;

            background: var(--gradient-btn);

            color: #fff;

            padding: 13px 25px;

            border-radius: 7px;

            border: none;

            text-decoration: none;

            font-size: 0.95rem;
            font-weight: 700;

            cursor: pointer;

            box-shadow: 0 0 20px var(--blue-glow);

            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .btn:hover {
            transform: translateY(-2px);

            box-shadow:
                0 0 30px rgba(0, 210, 255, 0.6);
        }

        .btn:active {
            transform: translateY(0);
        }

        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 100vh;

            padding: 160px 0 100px;

            display: flex;
            align-items: center;

            background: var(--gradient-hero);

            border-bottom: 1px solid var(--border-blue);

            position: relative;
        }

        .hero-grid {
            display: grid;

            grid-template-columns:
                minmax(0, 1.15fr)
                minmax(0, 0.85fr);

            gap: 50px;

            align-items: center;
        }

        .hero-badge {
            display: inline-block;

            padding: 7px 16px;

            margin-bottom: 20px;

            border-radius: 50px;

            background: rgba(0, 210, 255, 0.1);

            border: 1px solid var(--blue-electric);

            color: var(--blue-electric);

            font-size: 0.8rem;
            font-weight: 700;

            letter-spacing: 1px;
        }

        .hero h1 {
            font-size: clamp(2.3rem, 5vw, 3.8rem);

            line-height: 1.1;

            font-weight: 800;

            margin-bottom: 24px;

            background:
                linear-gradient(
                    180deg,
                    #ffffff 0%,
                    #b0c4de 100%
                );

            -webkit-background-clip: text;
            background-clip: text;

            -webkit-text-fill-color: transparent;
        }

        .hero p {
            max-width: 650px;

            margin-bottom: 35px;

            color: var(--text-muted);

            font-size: 1.15rem;
        }

        .hero-image {
            overflow: hidden;

            border-radius: 14px;

            border: 1px solid var(--border-blue);

            box-shadow:
                0 0 40px rgba(0, 102, 255, 0.25);
        }

        .hero-image img {
            display: block;

            width: 100%;
            height: 430px;

            object-fit: cover;
        }

        /* =========================
           SEÇÕES
        ========================= */

        .section-header {
            text-align: center;

            margin-bottom: 55px;
        }

        .section-title {
            color: #fff;

            font-size: clamp(2rem, 4vw, 2.5rem);

            font-weight: 800;

            margin-bottom: 10px;
        }

        .section-subtitle {
            color: var(--blue-electric);

            font-size: 0.85rem;

            font-weight: 700;

            letter-spacing: 1.5px;

            text-transform: uppercase;
        }

        /* =========================
           ABOUT
        ========================= */

        .about {
            padding: 100px 0;

            background: #081329;

            border-bottom: 1px solid var(--border-blue);
        }

        .about-grid {
            display: grid;

            grid-template-columns:
                minmax(0, 1fr)
                minmax(0, 1fr);

            gap: 60px;

            align-items: center;
        }

        .about-image {
            overflow: hidden;

            border-radius: 14px;

            border: 1px solid var(--border-blue);

            box-shadow:
                0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .about-image img {
            display: block;

            width: 100%;
            height: 450px;

            object-fit: cover;
        }

        .about-text p {
            color: var(--text-muted);

            font-size: 1.05rem;

            margin-bottom: 20px;
        }

        .entrepreneur-list {
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 16px;

            margin-top: 30px;
        }

        .entrepreneur-item {
            padding: 17px;

            background: var(--bg-card-blue);

            border-radius: 8px;

            border-left: 4px solid var(--blue-electric);
        }

        .entrepreneur-item h4 {
            color: #fff;

            font-size: 1rem;

            margin-bottom: 4px;
        }

        .entrepreneur-item p {
            font-size: 0.85rem;

            margin-bottom: 0;
        }

        /* =========================
           SERVICES
        ========================= */

        .services {
            padding: 100px 0;

            background: var(--bg-deep-blue);
        }

        .services-grid {
            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(280px, 1fr));

            gap: 30px;
        }

        .service-card {
            overflow: hidden;

            background: var(--bg-card-blue);

            border: 1px solid var(--border-blue);

            border-radius: 12px;

            transition:
                transform 0.3s ease,
                background 0.3s ease,
                border-color 0.3s ease,
                box-shadow 0.3s ease;
        }

        .service-card:hover {
            transform: translateY(-8px);

            background: var(--bg-card-hover);

            border-color: var(--blue-electric);

            box-shadow:
                0 10px 30px rgba(0, 210, 255, 0.15);
        }

        .service-img {
            height: 200px;

            overflow: hidden;
        }

        .service-img img {
            width: 100%;
            height: 100%;

            object-fit: cover;

            transition: transform 0.5s ease;
        }

        .service-card:hover .service-img img {
            transform: scale(1.08);
        }

        .service-content {
            padding: 24px;
        }

        .service-content h3 {
            color: var(--blue-electric);

            font-size: 1.2rem;

            margin-bottom: 12px;
        }

        .service-content p {
            color: var(--text-muted);

            font-size: 0.93rem;
        }

        /* =========================
           DIFERENCIAL
        ========================= */

        .differential {
            padding: 90px 0;

            background:
                linear-gradient(
                    180deg,
                    #0a1b3a 0%,
                    #060d1b 100%
                );

            border-top: 1px solid var(--border-blue);
            border-bottom: 1px solid var(--border-blue);
        }

        .diff-box {
            display: grid;

            grid-template-columns:
                minmax(0, 1fr)
                minmax(0, 1fr);

            gap: 40px;

            align-items: center;

            padding: 50px;

            background: var(--bg-card-blue);

            border: 1px solid var(--blue-electric);

            border-radius: 16px;

            box-shadow:
                0 0 50px rgba(0, 102, 255, 0.15);
        }

        .diff-text h3 {
            color: #fff;

            font-size: 1.8rem;

            margin-bottom: 16px;
        }

        .diff-text p {
            color: var(--text-muted);

            font-size: 1.05rem;

            margin-bottom: 20px;
        }

        .diff-highlights {
            list-style: none;
        }

        .diff-highlights li {
            position: relative;

            padding-left: 28px;

            margin-bottom: 14px;

            color: var(--text-main);

            font-weight: 500;
        }

        .diff-highlights li::before {
            content: "⚡";

            position: absolute;

            left: 0;
            top: 0;

            color: var(--blue-electric);
        }

        .diff-img {
            overflow: hidden;

            border-radius: 10px;

            border: 1px solid var(--border-blue);
        }

        .diff-img img {
            display: block;

            width: 100%;
            height: 330px;

            object-fit: cover;
        }

        /* =========================
           CONTATO
        ========================= */

        .contact {
            padding: 100px 0;

            background: var(--bg-deep-blue);
        }

        .form-wrapper {
            width: 100%;
            max-width: 850px;

            margin: 0 auto;

            padding: 48px;

            background: var(--bg-card-blue);

            border: 1px solid var(--border-blue);

            border-radius: 16px;

            box-shadow:
                0 20px 50px rgba(0, 0, 0, 0.6);
        }

        .form-grid {
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-group label {
            display: block;

            margin-bottom: 8px;

            color: var(--text-main);

            font-size: 0.9rem;

            font-weight: 600;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;

            padding: 14px;

            background: #060d1b;

            border: 1px solid var(--border-blue);

            border-radius: 8px;

            color: #fff;

            font-family: 'Inter', sans-serif;

            font-size: 0.95rem;

            transition: 0.3s ease;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;

            border-color: var(--blue-electric);

            box-shadow:
                0 0 10px var(--blue-glow);
        }

        .form-group textarea {
            min-height: 140px;

            resize: vertical;
        }

        .form-group input[type="file"] {
            cursor: pointer;
        }

        .form-note {
            margin-top: 12px;

            color: var(--text-muted);

            font-size: 0.8rem;
        }

        .success-message {
            display: none;

            margin-bottom: 25px;

            padding: 15px;

            border-radius: 8px;

            background: rgba(0, 210, 255, 0.1);

            border: 1px solid var(--blue-electric);

            color: var(--blue-electric);

            text-align: center;

            font-weight: 600;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            padding: 40px 0;

            background: #030813;

            border-top: 1px solid var(--border-blue);

            text-align: center;

            color: var(--text-muted);

            font-size: 0.85rem;
        }

        /* =========================
           RESPONSIVIDADE
        ========================= */

        @media (max-width: 1050px) {

            .nav-links {
                display: none;
            }

            .hero-grid,
            .about-grid,
            .diff-box {
                grid-template-columns: 1fr;
            }

            .hero {
                padding-top: 130px;
            }

            .hero-image img {
                height: 380px;
            }

            .about-image img {
                height: 400px;
            }

            .diff-img img {
                height: 350px;
            }
        }

        @media (max-width: 700px) {

            .container {
                padding: 0 18px;
            }

            nav {
                min-height: 70px;
            }

            .logo {
                font-size: 0.9rem;
            }

            nav .btn {
                padding: 10px 14px;

                font-size: 0.75rem;
            }

            .hero {
                padding: 120px 0 70px;
            }

            .hero h1 {
                font-size: 2.35rem;
            }

            .hero p {
                font-size: 1rem;
            }

            .hero-image img {
                height: 280px;
            }

            .about,
            .services,
            .contact {
                padding: 70px 0;
            }

            .differential {
                padding: 70px 0;
            }

            .entrepreneur-list,
            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full {
                grid-column: auto;
            }

            .form-wrapper,
            .diff-box {
                padding: 28px 20px;
            }

            .about-image img {
                height: 300px;
            }

            .diff-img img {
                height: 260px;
            }

            .section-title {
                font-size: 1.9rem;
            }
        }

        @media (max-width: 450px) {

            .logo span {
                display: none;
            }

            nav .btn {
                font-size: 0.7rem;
                padding: 9px 10px;
            }

            .hero h1 {
                font-size: 2rem;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         HEADER
    ========================= -->

    <header>
        <div class="container">

            <nav>

                <div class="logo">
                    ⚡ THE FALCON
                    <span>MECHATRONICS 5.0 V8</span>
                </div>

                <ul class="nav-links">
                    <li>
                        <a href="#about">Quem Somos</a>
                    </li>

                    <li>
                        <a href="#services">Serviços</a>
                    </li>

                    <li>
                        <a href="#differential">Inovação V8</a>
                    </li>

                    <li>
                        <a href="#contact">Contato</a>
                    </li>
                </ul>

                <a href="#contact" class="btn">
                    Solicitar Orçamento
                </a>

            </nav>

        </div>
    </header>


    <!-- =========================
         HERO
    ========================= -->

    <main>

        <section class="hero">

            <div class="container">

                <div class="hero-grid">

                    <div>

                        <span class="hero-badge">
                            TECNOLOGIA DE PONTA 5.0 V8
                        </span>

                        <h1>
                            The Falcon
                            Mechatronics 5.0 V8
                        </h1>

                        <p>
                            Projetos CAD 3D de alta complexidade,
                            prototipagem e usinagem CNC sob medida.
                            Acelere seu ciclo industrial com engenharia
                            de alto desempenho.
                        </p>

                        <a href="#contact" class="btn">
                            Solicite um Orçamento V8
                        </a>

                    </div>

                    <div class="hero-image">

                        <img
                            src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=1000&q=80"
                            alt="Automação industrial e engenharia mecânica"
                            loading="eager"
                        >

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             QUEM SOMOS
        ========================= -->

        <section class="about" id="about">

            <div class="container">

                <div class="about-grid">

                    <div class="about-image">

                        <img
                            src="https://images.unsplash.com/photo-1581092580497-e0d23cbdf1dc?auto=format&fit=crop&w=800&q=80"
                            alt="Equipe de engenharia industrial"
                            loading="lazy"
                        >

                    </div>

                    <div class="about-text">

                        <span class="section-subtitle">
                            QUEM SOMOS
                        </span>

                        <h2 class="section-title">
                            Perfil de Engenharia &
                            Visão Empreendedora
                        </h2>

                        <p>
                            A <strong>The Falcon Mechatronics 5.0 V8</strong>
                            é uma empresa de engenharia especializada em
                            manufatura avançada e desenvolvimento de
                            dispositivos industriais inteligentes.
                        </p>

                        <p>
                            Nossa equipe une rigor científico,
                            velocidade operacional e visão empreendedora
                            para transformar desafios fabris complexos
                            em soluções físicas de alta performance.
                        </p>

                        <div class="entrepreneur-list">

                            <div class="entrepreneur-item">

                                <h4>Agilidade Lean</h4>

                                <p>
                                    Prototipagem rápida com foco na
                                    redução de prazos e desperdícios.
                                </p>

                            </div>

                            <div class="entrepreneur-item">

                                <h4>Rigor Científico</h4>

                                <p>
                                    Análises virtuais e simulações para
                                    validar soluções antes da fabricação.
                                </p>

                            </div>

                            <div class="entrepreneur-item">

                                <h4>Foco no Cliente</h4>

                                <p>
                                    Projetos sob medida orientados
                                    para desempenho e retorno.
                                </p>

                            </div>

                            <div class="entrepreneur-item">

                                <h4>Cultura 5.0</h4>

                                <p>
                                    Integração entre hardware, software,
                                    automação e inteligência computacional.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             SERVIÇOS
        ========================= -->

        <section class="services" id="services">

            <div class="container">

                <div class="section-header">

                    <span class="section-subtitle">
                        CAPACIDADES TÉCNICAS
                    </span>

                    <h2 class="section-title">
                        Soluções Mecatrônicas Integradas
                    </h2>

                </div>


                <div class="services-grid">


                    <article class="service-card">

                        <div class="service-img">

                            <img
                                src="https://images.unsplash.com/photo-1581092335397-9583fe92d232?auto=format&fit=crop&w=600&q=80"
                                alt="Projeto CAD 3D"
                                loading="lazy"
                            >

                        </div>

                        <div class="service-content">

                            <h3>
                                Projetos em CAD 3D / CAE
                            </h3>

                            <p>
                                Modelagem paramétrica avançada,
                                otimização topológica e análise
                                estrutural por elementos finitos
                                para validação digital.
                            </p>

                        </div>

                    </article>


                    <article class="service-card">

                        <div class="service-img">

                            <img
                                src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=600&q=80"
                                alt="Usinagem CNC"
                                loading="lazy"
                            >

                        </div>

                        <div class="service-content">

                            <h3>
                                Usinagem CNC Sob Medida
                            </h3>

                            <p>
                                Fresamento e torneamento de peças
                                metálicas complexas e polímeros
                                especiais com foco em precisão
                                e repetibilidade.
                            </p>

                        </div>

                    </article>


                    <article class="service-card">

                        <div class="service-img">

                            <img
                                src="https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=600&q=80"
                                alt="Eletrônica e placas PCB"
                                loading="lazy"
                            >

                        </div>

                        <div class="service-content">

                            <h3>
                                Eletrônica Dedicada
                            </h3>

                            <p>
                                Desenvolvimento de PCBs,
                                sistemas embarcados e integração
                                de sensores para aplicações industriais.
                            </p>

                        </div>

                    </article>


                    <article class="service-card">

                        <div class="service-img">

                            <img
                                src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=600&q=80"
                                alt="Automação industrial e programação de CLP"
                                loading="lazy"
                            >

                        </div>

                        <div class="service-content">

                            <h3>
                                Programação de CLP & IHM
                            </h3>

                            <p>
                                Automação de células de trabalho,
                                arquitetura de sistemas industriais
                                e interfaces homem-máquina.
                            </p>

                        </div>

                    </article>


                    <article class="service-card">

                        <div class="service-img">

                            <img
                                src="https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=600&q=80"
                                alt="Visão computacional e inteligência artificial"
                                loading="lazy"
                            >

                        </div>

                        <div class="service-content">

                            <h3>
                                Visão Computacional
                            </h3>

                            <p>
                                Sistemas de inspeção óptica automatizada
                                para controle de qualidade em tempo real
                                e identificação de inconformidades.
                            </p>

                        </div>

                    </article>


                </div>

            </div>

        </section>


        <!-- =========================
             DIFERENCIAL
        ========================= -->

        <section class="differential" id="differential">

            <div class="container">

                <div class="diff-box">

                    <div class="diff-text">

                        <span class="section-subtitle">
                            DIFERENCIAL & EFICIÊNCIA 5.0
                        </span>

                        <h3>
                            Zero Desperdício.
                            Máxima Performance V8.
                        </h3>

                        <p>
                            A The Falcon integra projeto,
                            engenharia e manufatura em um
                            ecossistema digital unificado.
                        </p>

                        <ul class="diff-highlights">

                            <li>
                                <strong>
                                    Otimização Topológica:
