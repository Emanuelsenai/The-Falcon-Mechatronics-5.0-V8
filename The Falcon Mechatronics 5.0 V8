<!DOCTYPE html>
<html lang="pt-BR">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>The Falcon Mechatronics 5.0 V8</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #050b18;
    color: white;
}

/* =========================
   HEADER
========================= */

header {
    width: 100%;
    background: #050b18;
    border-bottom: 1px solid #12346b;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
}

nav {
    max-width: 1200px;
    margin: auto;
    min-height: 75px;
    padding: 15px 20px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.logo {
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1px;
}

.logo span {
    color: #00d9ff;
}

.menu {
    display: flex;
    gap: 25px;
    list-style: none;
}

.menu a {
    color: #b8c4d9;
    text-decoration: none;
    font-size: 14px;
}

.menu a:hover {
    color: #00d9ff;
}

.botao {
    display: inline-block;
    background: linear-gradient(135deg, #0066ff, #00d9ff);
    color: white;
    padding: 13px 22px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    border: none;
    cursor: pointer;
}

/* =========================
   HERO
========================= */

.hero {
    min-height: 100vh;
    padding: 150px 20px 80px;

    background:
        radial-gradient(
            circle at 80% 30%,
            rgba(0, 102, 255, 0.25),
            transparent 35%
        ),
        linear-gradient(
            135deg,
            #050b18,
            #081a3c,
            #002b63
        );

    display: flex;
    align-items: center;
}

.hero-container {
    width: 100%;
    max-width: 1200px;
    margin: auto;

    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}

.tag {
    display: inline-block;
    color: #00d9ff;
    border: 1px solid #00d9ff;
    padding: 8px 15px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: 55px;
    line-height: 1.05;
    margin-bottom: 25px;
}

.azul {
    color: #00d9ff;
}

.hero p {
    color: #aab7ca;
    font-size: 18px;
    line-height: 1.7;
    margin-bottom: 30px;
}

/* MOTOR VISUAL */

.motor {
    height: 400px;
    border: 1px solid #1a4a91;
    border-radius: 20px;

    background:
        radial-gradient(
            circle,
            #0066ff 0%,
            #07316e 20%,
            #08162f 55%,
            #030817 100%
        );

    display: flex;
    justify-content: center;
    align-items: center;

    box-shadow:
        0 0 60px rgba(0, 145, 255, 0.25);

    position: relative;
}

.motor::before {
    content: "V8";

    font-size: 150px;
    font-weight: bold;
    color: rgba(255,255,255,0.08);

    position: absolute;
}

.motor-text {
    z-index: 2;
    text-align: center;
}

.motor-text div:first-child {
    font-size: 70px;
    font-weight: bold;
    color: #00d9ff;
    text-shadow: 0 0 30px #00d9ff;
}

.motor-text div:last-child {
    letter-spacing: 5px;
    color: white;
}

/* =========================
   SEÇÕES
========================= */

section {
    padding: 100px 20px;
}

.container {
    max-width: 1200px;
    margin: auto;
}

.titulo {
    text-align: center;
    margin-bottom: 60px;
}

.titulo small {
    color: #00d9ff;
    font-weight: bold;
    letter-spacing: 2px;
}

.titulo h2 {
    font-size: 38px;
    margin-top: 10px;
}

.titulo p {
    color: #8f9db3;
    margin-top: 15px;
}

/* =========================
   SOBRE
========================= */

.sobre {
    background: #081329;
}

.sobre-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}

.painel {
    min-height: 400px;
    border-radius: 15px;
    border: 1px solid #17417c;

    background:
        linear-gradient(
            135deg,
            #0c234d,
            #071225
        );

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 100px;
    color: #00d9ff;

    box-shadow: 0 20px 50px rgba(0,0,0,0.4);
}

.texto h2 {
    font-size: 35px;
    margin-bottom: 20px;
}

.texto p {
    color: #aab7ca;
    margin-bottom: 20px;
    line-height: 1.8;
}

.cards-mini {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-top: 30px;
}

.mini {
    background: #0d1c3b;
    border-left: 4px solid #00d9ff;
    padding: 18px;
    border-radius: 5px;
}

.mini h3 {
    color: white;
    font-size: 16px;
    margin-bottom: 5px;
}

.mini p {
    font-size: 13px;
    margin: 0;
}

/* =========================
   SERVIÇOS
========================= */

.servicos {
    background: #050b18;
}

.servicos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.servico {
    background: #0d1b3b;
    border: 1px solid #19386c;
    border-radius: 12px;
    padding: 30px;

    transition: 0.3s;
}

.servico:hover {
    transform: translateY(-8px);
    border-color: #00d9ff;
    box-shadow: 0 15px 40px rgba(0,210,255,0.15);
}

.icone {
    font-size: 40px;
    margin-bottom: 20px;
}

.servico h3 {
    color: #00d9ff;
    margin-bottom: 12px;
}

.servico p {
    color: #9ba9bd;
    line-height: 1.7;
    font-size: 14px;
}

/* =========================
   DIFERENCIAL
========================= */

.diferencial {
    background: linear-gradient(#081a38, #050b18);
}

.diferencial-box {
    border: 1px solid #00d9ff;
    border-radius: 15px;
    padding: 50px;

    background: #0b1935;

    box-shadow: 0 0 50px rgba(0,210,255,0.1);
}

.diferencial-box h2 {
    font-size: 35px;
    margin-bottom: 20px;
}

.diferencial-box p {
    color: #9daabe;
    line-height: 1.8;
    margin-bottom: 30px;
}

.lista {
    list-style: none;
}

.lista li {
    padding: 15px 0;
    border-bottom: 1px solid #1a3158;
    color: #dce7f7;
}

.lista li::before {
    content: "⚡";
    color: #00d9ff;
    margin-right: 10px;
}

/* =========================
   CONTATO
========================= */

.contato {
    background: #050b18;
}

.formulario {
    max-width: 800px;
    margin: auto;

    background: #0d1b3b;

    padding: 40px;

    border: 1px solid #19386c;
    border-radius: 15px;
}

.linha {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.campo {
    margin-bottom: 20px;
}

.campo label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
    font-size: 14px;
}

.campo input,
.campo select,
.campo textarea {
    width: 100%;
    padding: 14px;

    background: #050b18;
    color: white;

    border: 1px solid #234476;
    border-radius: 6px;

    font-family: Arial;
}

.campo input:focus,
.campo select:focus,
.campo textarea:focus {
    outline: none;
    border-color: #00d9ff;
}

.campo textarea {
    min-height: 130px;
    resize: vertical;
}

.formulario .botao {
    width: 100%;
    font-size: 16px;
}

/* =========================
   RODAPÉ
========================= */

footer {
    background: #020611;
    border-top: 1px solid #173563;
    padding: 35px 20px;
    text-align: center;
    color: #77869e;
    font-size: 13px;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 900px) {

    .menu {
        display: none;
    }

    .hero-container,
    .sobre-grid {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 42px;
    }

    .servicos-grid {
        grid-template-columns: 1fr 1fr;
    }

    .motor {
        height: 300px;
    }

}

@media (max-width: 600px) {

    nav {
        padding: 12px 15px;
    }

    .logo {
        font-size: 13px;
    }

    nav .botao {
        padding: 10px 12px;
        font-size: 11px;
    }

    .hero {
        padding-top: 120px;
    }

    .hero h1 {
        font-size: 35px;
    }

    .hero p {
        font-size: 16px;
    }

    section {
        padding: 70px 15px;
    }

    .titulo h2 {
        font-size: 30px;
    }

    .servicos-grid,
    .cards-mini,
    .linha {
        grid-template-columns: 1fr;
    }

    .painel {
        min-height: 280px;
    }

    .diferencial-box,
    .formulario {
        padding: 25px;
    }

}

</style>

</head>

